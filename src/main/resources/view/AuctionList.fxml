<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0"
      prefWidth="940.0"
      maxHeight="1.7976931348623157E308"
      maxWidth="1.7976931348623157E308"
      fillWidth="true"
      spacing="14.0"
      id="auctionListRoot"
      stylesheets="@marketplace.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.AuctionListController">
    <padding>
        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="page-header">
        <Label styleClass="page-title" text="Auction Catalog"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel"/>
        <Button onAction="#handleLogout" text="Logout"/>
    </HBox>

    <VBox styleClass="panel" spacing="12.0">
        <Label styleClass="support-copy" text="Search the catalog, isolate live sessions, and sort by urgency or price before opening a sale." wrapText="true"/>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
            <TextField fx:id="searchField" promptText="Search by item name" HBox.hgrow="ALWAYS"/>
            <ChoiceBox fx:id="statusFilterChoiceBox" prefWidth="150.0"/>
            <ChoiceBox fx:id="sortChoiceBox" prefWidth="170.0"/>
            <CheckBox fx:id="openOnlyCheckBox" text="Open only"/>
            <Button onAction="#handleClearFilters" text="Clear Filters"/>
        </HBox>
        <Label fx:id="resultCountLabel" styleClass="result-summary" text="Loading auctions..."/>
    </VBox>

    <TableView fx:id="auctionTable"
               prefHeight="430.0"
               maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="250.0" text="Item"/>
            <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status"/>
            <TableColumn fx:id="currentPriceColumn" prefWidth="130.0" text="Current Price"/>
            <TableColumn fx:id="minimumBidColumn" prefWidth="150.0" text="Next Minimum Bid"/>
            <TableColumn fx:id="timeRemainingColumn" prefWidth="130.0" text="Time Left"/>
            <TableColumn fx:id="endTimeColumn" prefWidth="170.0" text="Ends At"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="openAuctionButton" onAction="#handleOpenAuction" text="Open Auction"/>
    </HBox>
</VBox>
