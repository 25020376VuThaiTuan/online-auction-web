<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>online-auction-web</artifactId>
    <version>1.0-SNAPSHOT</version>

    <distributionManagement>
        <repository>
            <id>github-private-repo</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/25020376VuThaiTuan/online-auction-web</url>
        </repository>
    </distributionManagement>
    <repositories>
        <repository>
            <id>github-private-repo</id>
            <name>My Private Project Repository</name>
            <url>https://maven.pkg.github.com/25020376VuThaiTuan/online-auction-web</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.6</javafx.version>
        <mysql.version>8.3.0</mysql.version>
        <junit.version>5.10.2</junit.version>
        <app.mainClass>org.example.Launcher</app.mainClass>
        <api.server.mainClass>org.example.server.AuctionApiServerMain</api.server.mainClass>
    </properties>

    <dependencies>
        <!-- JavaFX provides the desktop UI workflow for this project. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JDBC is optional at runtime and only used when DB env vars are configured. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <!-- Default developer run path: `mvn exec:java` starts the JavaFX desktop app. -->
                <configuration>
                    <mainClass>${app.mainClass}</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>api-server</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <!-- Standalone API server path: `mvn exec:java@api-server`. -->
                            <mainClass>${api.server.mainClass}</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <ignoredDependencies>
                        <!-- JavaFX resolves platform-specific classifier artifacts that dependency:analyze reports as undeclared. -->
                        <ignoredDependency>org.openjfx:*</ignoredDependency>
                        <!-- MySQL is a runtime JDBC driver loaded by DriverManager when DB env vars are configured. -->
                        <ignoredDependency>com.mysql:mysql-connector-j</ignoredDependency>
                        <!-- JUnit's engine is needed at test runtime, not referenced directly by test source. -->
                        <ignoredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredDependency>
                    </ignoredDependencies>
                </configuration>
            </plugin>


            <!-- This plugin keeps `mvn javafx:run` aligned with the default JavaFX app entrypoint. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${app.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
<dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter</artifactId>
    <version>5.10.2</version>
    <scope>test</scope>
</dependency>

<dependency>
    <groupId>org.mockito</groupId>
    <artifactId>mockito-core</artifactId>
    <version>5.11.0</version>
    <scope>test</scope>
</dependency>

<dependency>
    <groupId>org.testfx</groupId>
    <artifactId>testfx-junit5</artifactId>
    <version>4.0.18</version>
    <scope>test</scope>
</dependency>

<dependency>
    <groupId>com.h2database</groupId>
    <artifactId>h2</artifactId>
    <scope>test</scope>
</dependency>