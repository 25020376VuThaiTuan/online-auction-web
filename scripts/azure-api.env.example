# Copy this file to scripts\azure-api.env on Windows or scripts/azure-api.env on Linux/macOS.
# The copied file is ignored by Git and can contain real Azure MySQL passwords.

# Azure Database for MySQL Flexible Server.
# Host format: <server-name>.mysql.database.azure.com.
AUCTION_DB_URL=jdbc:mysql://<MYSQL_SERVER_NAME>.mysql.database.azure.com:3306/auctiondb?sslMode=REQUIRED&serverTimezone=UTC
AUCTION_DB_USER=auction_app
AUCTION_DB_PASSWORD=replace_with_azure_mysql_password

# Standalone API process. Azure Container Apps/App Service should route traffic to this same port.
AUCTION_API_PORT=8081

# JavaFX client endpoint after the API is deployed to Azure.
# Container Apps: https://<CONTAINER_APP_FQDN>/api
# App Service: https://<APP_NAME>.azurewebsites.net/api
AUCTION_API_BASE_URL=https://<AZURE_API_HOST>/api

# Optional API tuning for Azure-hosted API instances.
# AUCTION_API_WORKER_THREADS=16
# AUCTION_API_TOKEN_TTL_SECONDS=86400
# AUCTION_API_ALLOWED_ORIGIN=https://<allowed-browser-origin>
# AUCTION_API_VIRTUAL_THREADS=true
# AUCTION_DB_MAX_POOL_SIZE=8
# AUCTION_DB_BORROW_TIMEOUT_MILLIS=5000
