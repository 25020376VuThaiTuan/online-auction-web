# Copy this file to scripts\remote.env on Windows or scripts/remote.env on Linux/macOS,
# then replace the placeholders. The copied file is ignored by Git and can contain real passwords.

# Used by scripts\Start-RemoteApi.ps1 and scripts/start-remote-api.sh.
AUCTION_DB_URL=jdbc:mysql://<MYSQL_HOST>:3306/auctiondb?sslMode=REQUIRED&serverTimezone=UTC
AUCTION_DB_USER=auction_app
AUCTION_DB_PASSWORD=replace_with_a_long_password
AUCTION_API_PORT=8081

# Used by scripts\Start-RemoteClient.ps1 and scripts/start-remote-client.sh.
# Use http://localhost:8081/api when the API script runs on this workstation.
AUCTION_API_BASE_URL=http://localhost:8081/api

# Optional tuning. Uncomment only when you need to override the defaults.
# AUCTION_API_WORKER_THREADS=16
# AUCTION_API_TOKEN_TTL_SECONDS=86400
# AUCTION_API_CONNECT_TIMEOUT_MILLIS=3000
# AUCTION_API_REQUEST_TIMEOUT_MILLIS=5000
