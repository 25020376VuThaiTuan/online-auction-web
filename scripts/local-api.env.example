# Copy this file to scripts\local-api.env when you want the JavaFX client to talk
# to an API process running on this workstation. The copied file is ignored by Git.

# Used by scripts\Start-LocalApi.ps1 and scripts/start-local-api.sh.
AUCTION_API_PORT=8081
AUCTION_DEMO_ACCOUNTS_ENABLED=true

# Used by scripts\Start-LocalClient.ps1 and scripts/start-local-client.sh.
AUCTION_API_BASE_URL=http://localhost:8081/api

# Optional tuning. Uncomment only when you need to override the defaults.
# AUCTION_API_WORKER_THREADS=16
# AUCTION_API_TOKEN_TTL_SECONDS=86400
# AUCTION_API_CONNECT_TIMEOUT_MILLIS=3000
# AUCTION_API_REQUEST_TIMEOUT_MILLIS=5000
